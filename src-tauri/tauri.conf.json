{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Defrag Racing Launcher",
  "version": "0.1.35",
  "identifier": "racing.defrag.launcher",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Defrag Racing Launcher",
        "width": 960,
        "height": 680,
        "minWidth": 720,
        "minHeight": 520,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "category": "Utility",
    "shortDescription": "Demo backup and map launcher for defrag.racing",
    "longDescription": "Automatically back up Quake 3 Defrag demos to defrag.racing and open defrag:// deep links directly in the engine of your choice.",
    "resources": [
      "resources/odfe/*"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      },
      "wix": {
        "fragmentPaths": ["wix/cleanup.wxs"],
        "componentGroupRefs": ["LauncherCleanup"]
      }
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["defrag"]
      }
    },
    "updater": {
      "active": true,
      "dialog": false,
      "endpoints": [
        "https://defrag.racing/launcher/latest.json",
        "https://github.com/Defrag-racing/defrag-racing-launcher/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEFENkQ0NUYyMTdBM0I3Q0MKUldUTXQ2TVg4a1Z0cmQ3a01kMHdZK2ZjM3UxNE9FNVNTcDFaVTBCaFBRUDQ5dDB5RTdPekg0QUgK"
    }
  }
}
